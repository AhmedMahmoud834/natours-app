extends base

block append head
  link(rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css")
  script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer)
  script(src="https://unpkg.com/axios/dist/axios.min.js" defer)
  script(src="/js/leaflet.js" defer)
  script(src="/js/reviewsSlider.js" defer)
  script(src="https://js.stripe.com/v3/" defer)
  script(src="/js/stripe.js" defer)
  script(src="/js/tourDetails.js" defer)
  script(src="/js/writeReview.js" defer)

block content
  main.main#tour-container(data-slug=slug data-user-role=(user ? user.role : '') data-user-id=(user ? user.id : ''))
    .tour-loading
      .tour-loading__hero
      .tour-loading__body
        .tour-loading__text
        .tour-loading__text.tour-loading__text--short
        .tour-loading__text
        .tour-loading__text.tour-loading__text--short
      .tour-loading__label Loading tour...

  if user && user.role === 'user'
    section.section-write-review
      .review-form-container
        h2.heading-secondary#review-form-title Leave a Review
        form#review-form(data-tour-id=(tour ? `${tour.id}` : ''))
          .form__group
            label.form__label Rating
            .star-rating
              - for (let i = 1; i <= 5; i++)
                svg.star-icon(data-rating=`${i}`)
                  use(xlink:href='/img/icons.svg#icon-star')
            input#review-rating(type='hidden', required)
          
          .form__group
            label.form__label(for='review-content') Your Experience
            textarea#review-content.form__input(rows='4', required, placeholder='Share your adventure with others...', autocomplete='off', spellcheck='false')
          
          .form__group.form__group--actions(style='display: flex; justify-content: flex-end; align-items: center; gap: 1.5rem; margin-top: 2rem;')
            button.btn.btn-delete#delete-review-btn(type='button' style='display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #ef4444; padding: 1.2rem 2.4rem; border-radius: 10rem; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.2s;') Delete Review
            button.btn.btn-primary#submit-review(type='submit') Submit Review

  style.
    .tour-loading {
      min-height: 100vh;
      background: #0b101e;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .tour-loading__hero {
      width: 100%;
      height: 40vh;
      background: linear-gradient(90deg, #1a2340 25%, #243050 50%, #1a2340 75%);
      background-size: 200% 100%;
      animation: shimmer 1.6s infinite;
    }
    .tour-loading__body {
      width: 100%;
      max-width: 80rem;
      padding: 4rem 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }
    .tour-loading__text {
      height: 1.6rem;
      border-radius: 0.4rem;
      background: linear-gradient(90deg, #1a2340 25%, #243050 50%, #1a2340 75%);
      background-size: 200% 100%;
      animation: shimmer 1.6s infinite;
      width: 100%;
    }
    .tour-loading__text--short { width: 55%; }
    .tour-loading__label {
      color: rgba(248, 249, 250, 0.6);
      font-size: 1.4rem;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.5px;
      margin-top: 2rem;
    }
    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
