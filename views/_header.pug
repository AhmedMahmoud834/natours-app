//- Transparent vs Solid capability can be handled via a class on the header element
//- e.g., header.header(class=`${isTransparent ? 'header--transparent' : 'header--solid'}`)
header.header.header--transparent
  .header__logo
    a(href="/") NATOURS
  
  nav.header__nav.header__nav--tours
    a.header__nav-link(href="/tours") All tours
  
  nav.header__nav.header__nav--user
    if user
      if user.role === 'admin'
        a.header__nav-link(href="/admin/overview" style="margin-right: 1.5rem; color: #FF6B35;") Admin Panel
      else if user.role === 'lead-guide'
        a.header__nav-link(href="/lead-guide-dashboard" style="margin-right: 1.5rem; color: #FF6B35;") Guide Panel
      else if user.role === 'guide'
        a.header__nav-link(href="/guide-dashboard" style="margin-right: 1.5rem; color: #FF6B35;") Guide Panel
      a.header__nav-link.header__nav-link--logout(href="#") Log out
      a.header__nav-link.header__nav-link--profile(href="/me")
        img.header__user-img(src=`/img/users/${user.photo || 'default.jpg'}` alt=`Photo of ${user.name}`)
        span.header__user-name= user.name.split(' ')[0]
    else
      a.header__nav-link(href="/login") Log in
      a.header__nav-link.header__nav-link--cta(href="/signup") Sign up
