mixin tourForm(options = {})
  form#tour-form.form.glass-form(style=options.hidden ? 'display: none;' : '')
    h3#form-title.heading-tertiary.ma-bt-sm= options.title || 'Create New Tour'
    
    .form__group
      label.form__label(for='edit-name') Tour Name
      input#edit-name.form__input(type='text', required, minlength='10', maxlength='40', placeholder='e.g., The Forest Hiker')
    
    .form__group-row(style='display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;')
      .form__group
        label.form__label(for='edit-duration') Duration (Days)
        input#edit-duration.form__input(type='number', required, min='1', placeholder='e.g., 5')
      .form__group
        label.form__label(for='edit-max-group-size') Max Group Size
        input#edit-max-group-size.form__input(type='number', required, min='1', placeholder='e.g., 25')
    
    .form__group-row(style='display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;')
      .form__group
        label.form__label(for='edit-difficulty') Difficulty
        select#edit-difficulty.form__input
          option(value='easy') Easy
          option(value='medium' selected) Medium
          option(value='difficult') Difficult
      .form__group
        label.form__label(for='edit-price') Price ($)
        input#edit-price.form__input(type='number', required, min='1', placeholder='e.g., 397')
      .form__group
        label.form__label(for='edit-price-discount') Discount ($)
        input#edit-price-discount.form__input(type='number', min='0', placeholder='e.g., 50')

    .form__group.locations-section
      h4.heading-tertiary Tour Stops
      #locations-container
        //- JavaScript will inject .location-block divs here
      button(type="button").btn-small.btn-outline-orange#btn-add-location + Add Stop

    .form__group
      label.form__label(for='edit-summary') Summary
      input#edit-summary.form__input(type='text', required, placeholder='Brief summary of the tour')
    
    .form__group
      label.form__label(for='edit-description') Description
      textarea#edit-description.form__input(rows='3', required, placeholder='Full tour description')

    .form__group
      label.form__label(for='edit-guides') Supporting Guides (Hold Ctrl / Cmd to select multiple)
      select#edit-guides.form__input(multiple size='4' style='height: auto; min-height: 9rem;')
        if guides && guides.length
          optgroup(label='Lead Guides')
            each g in guides.filter(u => u.role === 'lead-guide')
              option(value=g.id)= `${g.name} (${g.email})`
          optgroup(label='Guides')
            each g in guides.filter(u => u.role === 'guide')
              option(value=g.id)= `${g.name} (${g.email})`
        else if availableGuides && availableGuides.length
          each g in availableGuides
            option(value=g.id)= `${g.name} (${g.email})`
        else
          option(disabled) No supporting guides found
    
    .form__group
      label.form__label(for='edit-start-dates') Start Dates (comma-separated: YYYY-MM-DD)
      input#edit-start-dates.form__input(type='text', required, placeholder='2025-06-15, 2025-07-20, 2025-08-25')

    .form__group
      label.form__label(for='edit-start-location-desc') Start Location Name
      input#edit-start-location-desc.form__input(type='text', required, placeholder='e.g., Banff, Canada')

    .form__group-row(style='display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;')
      .form__group
        label.form__label(for='edit-start-location-address') Address
        input#edit-start-location-address.form__input(type='text', placeholder='e.g., 224 Banff Ave, Banff, AB')
      .form__group
        label.form__label(for='edit-start-location-coords') Coordinates (lng, lat)
        input#edit-start-location-coords.form__input(type='text', required, placeholder='e.g., -115.57077, 51.17836')

    .form__group-row(style='display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;')
      .form__group
        label.form__label(for='edit-image-cover') Cover Image
        input#edit-image-cover.form__input(type='file', accept='image/*')
      .form__group
        label.form__label(for='edit-images') Gallery Images (up to 3)
        input#edit-images.form__input(type='file', multiple, accept='image/*')

    .form__group.form__group--actions
      button#btn-save.btn.btn-save.btn--small.btn--primary(type='submit')= options.saveText || 'Save Tour'
      if options.showStatusBtn
        button#btn-status.btn.btn-deactivate.btn--small.btn-outline(type='button', style='display: none;') Deactivate Tour
      if options.showDeleteBtn
        button#btn-delete.btn.btn-delete.btn--small(type='button', style='display: none;') Delete Tour
      button#btn-cancel.btn.btn-cancel.btn--small.btn-outline(type='button', style=options.cancelHidden ? 'display: none;' : '') Cancel
