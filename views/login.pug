extends base

block append head
  script(src='/js/login.js' defer)

block content
  main.main
    section.section-login
      .login-form
        h2.heading-secondary.ma-bt-lg Log into your account
        form.form.form--login
          .form__group
            label.form__label(for='email') Email address
            input#email.form__input.form__input--email(type='email', placeholder='you@example.com', required)
          .form__group.ma-bt-md
            label.form__label(for='password') Password
            input#password.form__input.form__input--password(type='password', placeholder='••••••••', required, minlength='8')
          .form__group.form__group--actions
            button.btn.btn--primary.btn--pill Log in
            a.form__link(href='/forgotPassword') Forgot password?

        .demo-accounts(style="margin-top: 3rem; border-top: 1px solid rgba(255, 107, 53, 0.2); padding-top: 2rem; text-align: center;")
          p(style="color: #F8F9FA; margin-bottom: 1.5rem; font-size: 1.4rem;") Quick Login (Demo Accounts)
          .demo-accounts__buttons(style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;")
            button.btn.btn-small.demo-btn(type='button', data-email='admin@natours.io', data-pass='test1234', style="background: transparent; border: 1px solid #FF6B35; color: #FF6B35;") Admin
            button.btn.btn-small.demo-btn(type='button', data-email='steve@example.com', data-pass='test1234', style="background: transparent; border: 1px solid #FF6B35; color: #FF6B35;") Lead Guide
            button.btn.btn-small.demo-btn(type='button', data-email='ayls@example.com', data-pass='test1234', style="background: transparent; border: 1px solid #FF6B35; color: #FF6B35;") User
