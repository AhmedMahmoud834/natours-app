extends baseEmail

block content
  h1 Account Activated! 🎉
  p Hi #{firstName || name},
  p Great news! Your Natours account has been successfully activated by an administrator.
  p Here are your temporary login credentials:

  .info-box
    .detail-row
      .detail-label NAME
      .detail-value #{name}
    .detail-row
      .detail-label TEMPORARY PASSWORD
      .detail-value
        code(style='background: #1E293B; padding: 4px 10px; border-radius: 4px; font-size: 15px; color: #FF6B35; letter-spacing: 1px;') #{password}

  p(style='color: #FF6B35; font-weight: 600;') ⚠️ For your security, please log in and change this password immediately.
  if url
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td(align='left')
            table(role='presentation', border='0', cellpadding='0', cellspacing='0')
              tbody
                tr
                  td
                    a(href=`${url}`, target='_blank') Log In to Your Account
  p.text-muted If you did not expect this activation, please contact our support team immediately.
  p - The Natours Team
