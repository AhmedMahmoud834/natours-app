extends baseEmail

block content
  h1 Booking Cancelled
  p Hi #{firstName},
  p Your booking for <strong>#{tourName}</strong> has been cancelled.

  .info-box
    .detail-row
      .detail-label TOUR
      .detail-value #{tourName}
    .detail-row
      .detail-label TICKETS
      .detail-value #{participants} #{participants > 1 ? 'guests' : 'guest'}
    .detail-row
      .detail-label AMOUNT
      .detail-value $#{price}

  p If this was a mistake or you'd like to rebook, you can always explore our available tours.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Explore Tours
  p.text-muted If you have any questions, feel free to reply to this email.
  p - The Natours Team
