extends baseEmail

block content
  h1 Refund Processed
  p Hi #{firstName},
  p A refund has been issued for your booking of the <strong>#{tourName}</strong> tour.

  .info-box
    .detail-row
      .detail-label TOUR
      .detail-value #{tourName}
    .detail-row
      .detail-label TICKETS
      .detail-value #{participants} #{participants > 1 ? 'guests' : 'guest'}
    .detail-row
      .detail-label REFUND AMOUNT
      .detail-value
        span.highlight $#{price}

  p The refund has been credited to your original payment method. Please allow 5–10 business days for it to appear on your statement.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Account
  p.text-muted If you don't see the credit within 10 business days, please reach out to our support team.
  p - The Natours Team
