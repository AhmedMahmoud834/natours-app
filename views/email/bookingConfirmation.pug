extends baseEmail

block content
  p Hi #{firstName},
  p Your booking was successfully confirmed! 🎉
  p Thank you for booking the <strong>#{tourName}</strong> tour. Your total payment of <strong>$#{price}</strong> has been received.
  p We are thrilled to have you on board for this adventure!
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Your Bookings
  p If you have any questions or need to make changes to your itinerary, please don't hesitate to reply to this email.
  p - The Natours Team
