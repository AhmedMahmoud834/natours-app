extends baseEmail

block content
  h1 Booking Confirmed! 🎉
  p Hi #{firstName},
  p Thank you for booking with Natours! Your adventure awaits.

  //- Order summary
  .info-box
    .detail-row
      .detail-label TOUR
      .detail-value #{tourName}
    .detail-row
      .detail-label TICKETS
      .detail-value
        span.highlight #{participants}
        |  #{participants > 1 ? 'guests' : 'guest'}
    .detail-row
      .detail-label TOTAL PAID
      .detail-value
        span.highlight $#{price}

  p We are thrilled to have you on board for this adventure! You can view and manage your bookings anytime from your account.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Your Bookings
  p.text-muted If you have any questions or need to make changes, simply reply to this email.
  p - The Natours Team
