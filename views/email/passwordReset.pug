extends baseEmail

block content
  h1 Password Reset
  p Hi #{firstName},
  p Forgot your password? No worries — click the button below to set a new one. This link is valid for 10 minutes.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset Your Password
  p.text-muted If you didn't request a password reset, please ignore this email. Your account is safe.
