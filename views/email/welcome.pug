extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to Natours, we're glad to have you! 🎉
  p We're all a big family here, so make sure to complete your profile by uploading your user photo so we get to know you a bit better!
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Upload user photo
  p If you need any help booking your next adventure, please don't hesitate to contact us!
  p - The Natours Team
