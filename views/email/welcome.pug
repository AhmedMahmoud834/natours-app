extends baseEmail

block content
  h1 Welcome to Natours! 🌍
  p Hi #{firstName},
  p We're glad to have you in the Natours family! Get ready for unforgettable adventures in the most beautiful nature the world has to offer.
  p Complete your profile by uploading a photo so we get to know you better!
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Complete Your Profile
  p.text-muted Need help booking your next adventure? Just reply to this email!
  p - The Natours Team
